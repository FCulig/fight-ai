{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": [
        "-c",
        "cd backend && exec .venv/bin/uvicorn app.main:app --reload"
      ],
      "port": 8000
    },
    {
      "name": "frontend",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev",
        "--prefix",
        "frontend"
      ],
      "port": 5173
    },
    {
      "name": "landing",
      "runtimeExecutable": "python3",
      "runtimeArgs": [
        "landing/dev_server.py",
        "4321"
      ],
      "port": 4321
    }
  ]
}
