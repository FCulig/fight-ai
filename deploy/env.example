# Production config. bootstrap-server.sh copies this to /opt/fight-ai/.env
# (mode 600, outside the git checkout) and fills in the generated values.
# deploy.sh symlinks it into deploy/ for docker compose.
# One KEY=value per line; keep comments on their own lines.

# Hostname Caddy serves and gets a TLS certificate for. Its DNS A record must
# point at this server's public IP.
SITE_ADDRESS=fightai.example.com
# The origin browsers see. Register <PUBLIC_BASE_URL>/api/auth/callback as an
# authorized redirect URI on the Google OAuth client.
PUBLIC_BASE_URL=https://fightai.example.com

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Comma-separated. These accounts become admin on their first sign-in only.
ADMIN_EMAILS=

POSTGRES_USER=fight_ai
POSTGRES_DB=fight_ai
# Generated by bootstrap-server.sh (openssl rand -hex 24). Hex keeps it safe
# inside DATABASE_URL.
POSTGRES_PASSWORD=
# Generated by bootstrap-server.sh (openssl rand -hex 32).
SESSION_SECRET=

# Email notifications: uploads waiting for the worker (to admins) and processing
# finished (to the uploader). Leave SMTP_HOST empty to turn them off.
# Gmail: a dedicated account with 2-Step Verification and an app password,
# host smtp.gmail.com, port 587, security starttls.
SMTP_HOST=
SMTP_PORT=587
# starttls (port 587), ssl (port 465) or none (local test server only)
SMTP_SECURITY=starttls
SMTP_USERNAME=
SMTP_PASSWORD=
# The From address. Defaults to SMTP_USERNAME.
MAIL_FROM=

# The host user that owns /srv/fight-ai. Set by bootstrap-server.sh.
APP_UID=1000
APP_GID=1000
