# Caddy gets and renews the TLS certificate for SITE_ADDRESS by itself. That
# needs the hostname's DNS A record pointing at this server and ports 80 and
# 443 open in both the Oracle security list and the VM's iptables (README.md).
{$SITE_ADDRESS} {
	# The app is behind sign-in; keep its sign-in page out of search so results
	# point at the landing page.
	header X-Robots-Tag "noindex, nofollow"
	# Compress JSON (a fight's frames are tens of MB) and the SPA. Never the SSE
	# stream, where buffering would hold back live state updates, and never
	# video, which is already compressed.
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type application/javascript*
			header Content-Type text/javascript*
			header Content-Type text/html*
			header Content-Type text/css*
			header Content-Type image/svg+xml*
		}
	}
	reverse_proxy backend:8000
}

# The landing page: static files from the checkout's landing/, so every deploy
# updates it. Unset, compose passes an unpublished port, so nothing is served.
{$LANDING_ADDRESS} {
	encode zstd gzip
	# The page's waitlist form posts here, so its one API call stays
	# same-origin and the backend needs no CORS. Nothing else under /api.
	handle /api/auth/waitlist {
		reverse_proxy backend:8000
	}
	handle {
		root * /srv/landing
		# landing/ also holds CLAUDE.md and the dev scripts; publish only the page
		# and the files search engines and link previews fetch.
		@private not path / /index.html /app/* /robots.txt /sitemap.xml /favicon.svg /apple-touch-icon.png /og.png
		respond @private 404
		file_server
	}
}
