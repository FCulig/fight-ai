# Copy this file to .env and fill in your values

DATABASE_URL=postgresql://user:password@localhost:5432/fight_ai

# Currently the app is using local file system to store and serve videos, this is a path to the ai/fight_videos
# folder from which the videos are served
VIDEO_BASE_DIR=users/...

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
PUBLIC_BASE_URL=http://localhost:5173
ADMIN_EMAILS=john.doe@mail.com

# Local only: mounts /api/auth/dev-login, which signs in without Google.
# The backend refuses to start with this set unless PUBLIC_BASE_URL is http://localhost or http://127.0.0.1.
DEV_LOGIN=1
